# Copy to .env and fill in. .env is git-ignored: never commit it.

# Optional. Without a key the AI rung is skipped and the UI says "AI suggestions off".
ANTHROPIC_API_KEY=
# Model for AI suggestions (default: a current Claude Sonnet model)
LLM_MODEL=claude-sonnet-5-5
# Max items sent to the AI per run (cached afterwards)
AI_MAX_ITEMS=200
# Where projects, uploads, runs and the SQLite DB live (created empty).
# In production (docker-compose.prod.yml) this is always /data inside a Docker volume.
BOMERANG_DATA_DIR=./data
# Optional multilingual embeddings for candidate retrieval (needs sentence-transformers)
BOMERANG_EMBEDDINGS=0

# ---- Production server only (docker-compose.prod.yml) ----
# Where the site is served:
#   :80                     -> http://<server-ip>        (no domain needed)
#   yourname.duckdns.org    -> https://yourname.duckdns.org (Caddy gets the certificate)
SITE_ADDRESS=:80
